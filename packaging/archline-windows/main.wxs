<?xml version='1.0' encoding='UTF-8'?>
<!-- Installer di ArchLine (WiX 3). File propri del fork: non toccano packaging/windows,
     che resta quello di upstream (usato da release.yml). Costruzione: build-msi.ps1. -->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='ArchLine'
    UpgradeCode='88739a2c-8c57-4c59-8960-d0b2fa5dad6e'
    Manufacturer='ArchLine'
    Language='1040'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package
      Id='*'
      Keywords='!(loc.Installer)'
      Description='!(loc.InstallerDescription)'
      Manufacturer='ArchLine'
      InstallerVersion='450'
      Languages='1040'
      Compressed='yes'
      InstallScope='perMachine'
      SummaryCodepage='1252' />

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='!(loc.DowngradeError)' />

    <Media Id='1' Cabinet='product.cab' EmbedCab='yes' />

    <Icon Id='AppIcon.ico' SourceFile='$(var.Icon)' />
    <Property Id='ARPPRODUCTICON' Value='AppIcon.ico' />
    <Property Id='ARPHELPLINK' Value='https://github.com/Ilmazza/ArchLine' />
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/Ilmazza/ArchLine' />
    <Property Id='ARPCOMMENTS' Value='!(loc.ApplicationDescription)' />
    <Property Id='ARPNOREPAIR' Value='1' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONROOTDIRECTORY' Name='ArchLine'>

          <Component Id='MainExecutable' Guid='2fdfe5ac-aaf1-45fa-a77e-3b63a3504156' Win64='yes'>
            <File
              Id='ArchLineEXE'
              Name='ArchLine.exe'
              DiskId='1'
              Source='$(var.Source)'
              KeyPath='yes'>
              <Shortcut
                Id='StartMenuShortcut'
                Directory='ProgramMenuDir'
                Name='ArchLine'
                Description='!(loc.Launch)'
                WorkingDirectory='APPLICATIONROOTDIRECTORY'
                Icon='AppIcon.ico'
                IconIndex='0'
                Advertise='yes' />
            </File>
            <File Id='DwgIco' Name='dwg.ico' DiskId='1' Source='$(var.IconsDir)\dwg.ico' />
            <File Id='DxfIco' Name='dxf.ico' DiskId='1' Source='$(var.IconsDir)\dxf.ico' />
            <File
              Id='DwgThumbDll'
              Name='dwg_thumbnailer_win.dll'
              DiskId='1'
              Source='$(var.ThumbDll)' />
            <ProgId
              Id='ArchLine.DWG'
              Description='!(loc.DwgDrawing)'
              Icon='DwgIco'
              IconIndex='0'>
              <Extension Id='dwg' ContentType='image/vnd.dwg'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='ArchLineEXE' Argument='"%1"' />
              </Extension>
            </ProgId>

            <ProgId
              Id='ArchLine.DXF'
              Description='!(loc.DxfDrawing)'
              Icon='DxfIco'
              IconIndex='0'>
              <Extension Id='dxf' ContentType='image/vnd.dxf'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='ArchLineEXE' Argument='"%1"' />
              </Extension>
            </ProgId>
          </Component>
          <Component Id='DefaultPrograms' Guid='a00a5107-85cb-47da-804c-19fe79a08847' Win64='yes'>
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\ArchLine.exe\DefaultIcon'
              Type='string'
              Value='[APPLICATIONROOTDIRECTORY]ArchLine.exe,0'
              KeyPath='yes' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\ArchLine.exe'
              Name='FriendlyAppName'
              Type='string'
              Value='ArchLine' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\ArchLine.exe\shell\open\command'
              Type='string'
              Value='"[APPLICATIONROOTDIRECTORY]ArchLine.exe" "%1"' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\ArchLine.exe\SupportedTypes'
              Name='.dwg'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\ArchLine.exe\SupportedTypes'
              Name='.dxf'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='Software\ArchLine\Capabilities'
              Name='ApplicationName'
              Type='string'
              Value='ArchLine' />
            <RegistryValue
              Root='HKLM'
              Key='Software\ArchLine\Capabilities'
              Name='ApplicationDescription'
              Type='string'
              Value='!(loc.ApplicationDescription)' />
            <RegistryValue
              Root='HKLM'
              Key='Software\ArchLine\Capabilities\FileAssociations'
              Name='.dwg'
              Type='string'
              Value='ArchLine.DWG' />
            <RegistryValue
              Root='HKLM'
              Key='Software\ArchLine\Capabilities\FileAssociations'
              Name='.dxf'
              Type='string'
              Value='ArchLine.DXF' />
            <RegistryValue
              Root='HKLM'
              Key='Software\RegisteredApplications'
              Name='ArchLine'
              Type='string'
              Value='Software\ArchLine\Capabilities' />
          </Component>

        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ProgramMenuDir' Name='ArchLine'>
          <Component Id='ProgramMenuDirComp' Guid='db646944-a226-4615-b359-743e8d6a3bb7'>
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue
              Root='HKCU'
              Key='Software\ArchLine'
              Name='installed'
              Type='integer'
              Value='1'
              KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>
      <Directory Id='DesktopFolder' Name='!(loc.Desktop)'>
        <Component Id='DesktopShortcutComp' Guid='be64efb8-3cba-4922-9d9d-55113d8ae471'>
          <Shortcut
            Id='DesktopShortcut'
            Name='ArchLine'
            Description='!(loc.Launch)'
            Target='[APPLICATIONROOTDIRECTORY]ArchLine.exe'
            WorkingDirectory='APPLICATIONROOTDIRECTORY'
            Icon='AppIcon.ico'
            IconIndex='0' />
          <RegistryValue
            Root='HKCU'
            Key='Software\ArchLine'
            Name='desktop_shortcut'
            Type='integer'
            Value='1'
            KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>

    <Feature Id='Complete' Title='ArchLine' Level='1' Display='expand'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='DefaultPrograms' />
      <ComponentRef Id='ProgramMenuDirComp' />
      <Feature
        Id='DesktopShortcut'
        Title='!(loc.DesktopShortcut)'
        Description='!(loc.DesktopShortcutDescription)'
        Level='1'
        Absent='allow'>
        <ComponentRef Id='DesktopShortcutComp' />
      </Feature>
    </Feature>
    <UIRef Id='ArchLineUI' />

  </Product>
</Wix>
